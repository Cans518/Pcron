#!/bin/bash

# Parse arguments
while getopts ":u:ler:" opt; do
    case $opt in
    u)
        inputName=$OPTARG
        ;;
    l)
        list=1
        ;;
    e)
        edit=1
        ;;
    r)
        remove=1
        ;;
    \?)
        echo "Invalid option: -$OPTARG" >&2
        exit 1
        ;;
    :)
        echo "Option -$OPTARG requires an argument." >&2
        exit 1
        ;;
    esac
done

# Permisson verify
name=$(/usr/bin/whoami)

if [ "$name" != "root" ]; then
    if [ -z "$inputName" ]; then
        echo "You must be root to run this script"
        exit 1
    elif [ "$name" != "$inputName" ]; then
        echo "Username does not match"
        exit 1
    fi

    # Check if user in /etc/pcron.allow or /etc/pcron.deny
    if [ -f /etc/pcron.allow ]; then
        if ! grep -q "$name" /etc/pcron.allow; then
            echo "User $name is not allowed to run pcrontab"
            exit 1
        fi
    elif [ -f /etc/pcron.deny ]; then
        if grep -q "$name" /etc/pcron.deny; then
            echo "User $name is not allowed to run pcrontab"
            exit 1
        fi
    fi
fi

