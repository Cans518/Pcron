#!/bin/bash
ROOT=""

# Parse arguments
while getopts ":u:lerh" opt; do
    case $opt in
    u)
        inputName=$OPTARG
        ;;
    l)
        task="list"
        ;;
    e)
        task="edit"
        ;;
    r)
        task="remove"
        ;;
    h)
        task="help"
        ;;
    \?)
        echo "Invalid option: -$OPTARG" >&2
        exit 1
        ;;
    :)
        echo "Option -$OPTARG requires an argument." >&2
        exit 1
        ;;
    esac
done

# Permisson verify
name=$(/usr/bin/whoami)

if [ "$name" != "root" ]; then
    if [ -z "$inputName" ]; then
        echo "You must be root to run this script or specify a username by '-u'"
        exit 1
    elif [ "$name" != "$inputName" ]; then
        echo "Username does not match"
        exit 1
    fi

    # Check if user in /etc/pcron.allow or /etc/pcron.deny
    # Priority of whitelist > blacklist
    if [ -f /etc/pcron.allow ]; then
        if ! grep -q "$name" "$ROOT/etc/pcron.allow"; then
            echo "User $name is not allowed to run pcrontab"
            exit 1
        fi
    elif [ -f /etc/pcron.deny ]; then
        if grep -q "$name" "$ROOT/etc/pcron.deny"; then
            echo "User $name is not allowed to run pcrontab"
            exit 1
        fi
    fi
fi

# Select file
if [ "$name" == "root" ] && [ -z "$inputName" ]; then
    filename="$ROOT/etc/pcrontab"
    inputName="root"
else
    filename="$ROOT/etc/pcron/pcrontab$inputName"
fi
if [ ! -f "$filename" ]; then
    # Create from template
    echo "File $filename does not exist, creating from template"
    cp "$ROOT/etc/pcrontab.template" "$filename"
fi

list_pcrontab() {
    echo "List pcrontab of user $inputName:"
    while IFS= read -r entry; do
        # Ignore comments, environment variables and empty lines
        if [[ $entry == \#* ]] || [[ $entry == [A-Z]* ]] || [ -z "$entry" ]; then
            continue
        fi
        printf "%s\n" "$entry" # Use printf to print '*' correctly
    done < "$filename"
}

edit_pcrontab() {
    # Make a temp file and edit it
    tempFile=$(mktemp)
    cp "$filename" "$tempFile"
    # Find an editor
    if test -x /usr/bin/editor; then
        editor=/usr/bin/editor
    elif test -x /usr/bin/vi; then
        editor=/usr/bin/vi
    elif test -x /usr/bin/nano; then
        editor=/usr/bin/nano
    else
        echo "No editor found"
        echo "You can edit the file manually: $filename and it will be reloaded after saving automatically"
        exit 1
    fi
    $editor "$tempFile"
    # Replace if different
    if ! cmp -s "$tempFile" "$filename"; then
        cp "$tempFile" "$filename"
        echo "File $filename has been updated"
    else
        echo "File $filename has not been changed"
    fi
    rm "$tempFile"
}

remove_pcrontab() {
    echo "Remove pcrontab: $filename"
    rm "$filename"
}

help() {
    echo "Usage: pcrontab <-u username> [-l | -e | -r]"
    echo "Options:"
    echo "  -u username  Specify username (or system-wide (root) if not set)"
    echo "  -l           List pcrontab"
    echo "  -e           Edit pcrontab"
    echo "  -r           Remove pcrontab"
    echo "  -h           Show this help message"
    exit 0
}

# Start processing
case "$task" in
    list)
        list_pcrontab
        ;;
    edit)
        edit_pcrontab
        ;;
    remove)
        remove_pcrontab
        ;;
    help)
        help
        ;;
    *)
        echo "Please specify an opreation. See -h"
        exit 1
        ;;
esac
