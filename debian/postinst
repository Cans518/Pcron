#!/bin/bash
# Install script for pcron

set -e

# Define colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to display messages in a consistent format
print_message() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_step() {
    echo -e "${CYAN}[STEP]${NC} $1"
}

print_header() {
    echo -e "${CYAN}========================================${NC}"
    echo -e "${CYAN}$1${NC}"
    echo -e "${CYAN}========================================${NC}"
}

# Start installation
print_header "Starting pcron installation"

# Make directories and copy files
print_step "1. Creating necessary directories and copying files..."
mkdir -p /var/lib/pcron/scripts/
if [ ! -f /etc/pcrontab ]; then
    cp -f /usr/share/pcron/pcrontab.template /etc/pcrontab # Global
    print_success "Created a global pcrontab config in /etc/pcrontab using the provided template."
else
    print_warning "Skipping: /etc/pcrontab already exists. No changes were made."
fi
touch /var/log/pcron.log
print_success "Log file created at /var/log/pcron.log for tracking pcron activities."

# Permissions
print_step "2. Setting permissions for executables and configuration files..."
chmod 755 /usr/bin/pcrontab
chmod 755 /usr/lib/pcron/pcron /usr/lib/pcron/parse-time.sh /usr/lib/pcron/func.sh
chmod 644 /etc/pcrontab
chmod 3777 /etc/pcron/ /var/lib/pcron/scripts/
print_success "Permissions successfully applied to ensure security and functionality."

# Systemd setup
print_step "3. Configuring systemd to manage pcron service..."
systemctl daemon-reload
systemctl enable --now pcron.service
print_success "pcron service has been enabled and started successfully."

# Final notes
print_step "4. Finalizing installation..."
print_success "pcron installation is complete!"
print_message "Here are some additional notes for using pcron:"
echo -e "  - To modify the global task schedule, edit ${BLUE}/etc/pcrontab${NC}."
echo -e "  - Logs for pcron can be found at ${BLUE}/var/log/pcron.log${NC}."
echo -e "  - Use ${BLUE}pcrontab -e${NC} to edit your personal cron jobs (if allowed)."
print_message "If you encounter any issues, check the logs or review the access control settings."

# Access control setup
print_message "pcron allows you to control which users can schedule tasks."
print_message "You can choose blacklist or whitelist users using the following files:"
echo -e "  - Blacklist users: ${BLUE}/etc/pcron.deny${NC}"
echo -e "  - Whitelist users: ${BLUE}/etc/pcron.allow${NC}"
echo -e "  - If you want to use Blacklist or Whitelist, create these files by 'touch /etc/pcron.allow' or 'touch /etc/pcron.deny'."
echo -e "  - And you must set the file as 644 permissions by 'chmod 644 /etc/pcron.allow' or '/etc/pcron.deny'"
echo -e "  - Now init the Whitelist Mode ……"
touch /etc/pcron.allow
chmod 644 /etc/pcron.allow
print_success "Init Whitelist Mode successfully."
print_warning "NOTE: You can only use one of them. If you use both, the access control will not work."
echo -e "  - To apply the changes, run 'systemctl daemon-reload' and 'systemctl restart pcron.service'"
echo -e "  - If you want to environment variables, you can set them by 'export PCRON_ALLOW=/etc/pcron.allow' or 'export PCRON_DENY=/etc/pcron.deny'."
print_warning "NOTE: Only root can modify these files. Use the environment variables \$PCRON_ALLOW and \$PCRON_DENY to manage access."

print_header "pcron installation finished successfully!"
exit 0